<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="table_rail_montage">

  <!-- rail_joint_type : "fixed" pour Gazebo (7 DOF → gravity comp OK)
                         "prismatic" pour RViz / visualisation standalone -->
  <!-- Position initiale du rail (m) — passée depuis le launch file.
       Le joint est fixe pour compatibilité avec FrankaHardwareInterface/KDL. -->
  <xacro:arg name="rail_position" default="0.0"/>

  <!-- Table (root link - KDL doesn't support inertia here, but Gazebo needs a small mass) -->
  <link name="table">
    <visual>
      <origin xyz="0 0 0.5"/>
      <geometry><box size="0.5 2 1"/></geometry>
      <material name="grey"><color rgba="0.6 0.6 0.6 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.5"/>
      <geometry><box size="0.5 2 1"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.5"/>
      <mass value="50.0"/>
      <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Rail sur la table-->
  <link name="rail">
    <visual>
      <origin xyz="0 0 1.01"/>
      <geometry><box size="0.20 1.9 0.02"/></geometry>
      <material name="blue"><color rgba="0 0 1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 1.01"/>
      <geometry><box size="0.20 1.9 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 1.01"/>
      <mass value="5.0"/>
      <inertia ixx="1.508" iyy="0.0167" izz="1.504" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  

  <joint name="table_to_rail" type="fixed">
    <parent link="table"/>
    <child link="rail"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- La pièce qui glisse ("montage") -->
  <link name="montage">
    <visual>
      <origin xyz="0.0 0 1.03"/>
      <geometry><box size="0.2 0.2 0.02"/></geometry>
      <material name="red"><color rgba="1 0 0 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.0 0 1.03"/>
      <geometry><box size="0.2 0.2 0.02"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0 1.03"/>
      <mass value="1.0"/>
      <inertia ixx="0.00333" iyy="0.00333" izz="0.00667" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="rail_joint" type="fixed">
    <origin xyz="0 ${-0.85 + $(arg rail_position)} 0" rpy="0 0 0"/>
    <parent link="rail"/>
    <child link="montage"/>
  </joint>
  
  


</robot>